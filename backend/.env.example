# --- Obligatoire ---
DATABASE_URL=postgresql://postgres:YOUR-POSTGRESQL-PASSWORD@localhost:5432/sehhatn
# Phrase longue et aléatoire (32 caractères minimum en production)
JWT_SECRET=type-a-long-random-sentence-here

# --- Facultatif ---
# Origines autorisées à appeler l'API (séparées par des virgules)
# CORS_ORIGINS=https://dhiaaelh.github.io,http://localhost:4200
# Masquer les données de démonstration (médecins, lieux, avis fictifs) — recommandé dès qu'il y a de vrais utilisateurs
# HIDE_DEMO_DATA=true
# Mot de passe des comptes de démo patient@demo.sehhatn.tn / medecin@demo.sehhatn.tn créés par `npm run db:seed`
# SEED_DEMO_PASSWORD=
# Flux RSS de l'accueil, séparés par des virgules
# NEWS_FEEDS=https://exemple.org/flux.xml
# Instances OpenStreetMap utilisées (repli automatique de l'une à l'autre)
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Assistant santé avec une IA (Gemini, Claude, ChatGPT ou autre). Sans clé, l'assistant fonctionne avec le moteur de règles seul.
# AI_API_KEY=
# Facultatif : gemini | openai | anthropic (deviné d'après la clé si absent)
# AI_PROVIDER=
# Facultatif : nom du modèle (sinon valeur par défaut du fournisseur)
# AI_MODEL=
# Facultatif : adresse d'une API compatible OpenAI (Groq, OpenRouter, Mistral...), ex. https://api.groq.com/openai/v1
# AI_BASE_URL=
# Limites de protection du quota : appels par visiteur et par heure, appels par jour pour tout le site
# AI_PER_IP_HOUR=30
# AI_DAILY_LIMIT=500
